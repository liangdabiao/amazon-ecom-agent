# ══ LLM（必填）—— 任意 OpenAI 兼容端点 ══
# DeepSeek:  https://api.deepseek.com/v1      模型 deepseek-chat
# 智谱GLM:   https://open.bigmodel.cn/api/paas/v4   模型 glm-4-plus
# Kimi:      https://api.moonshot.cn/v1       模型 moonshot-v1-128k
# OpenAI:    https://api.openai.com/v1        模型 gpt-4o
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
# 视觉模型（看图用，可选；留空则禁用看图能力）
LLM_VISION_MODEL=

# ══ 生图（用 Listing 主图 / 图片翻译时必填）══
# 需要有 gpt-image 权限的中转（原 IvyeaOps 的 Apimart 配置可直接沿用）
IMAGE_BASE_URL=
IMAGE_API_KEY=

# ══ 市场数据源（市场调研用，至少配一个）══
SORFTIME_KEY=
SELLERSPRITE_KEY=

# ══ 领星 ERP（只读查询，可选）══
LINGXING_HOST=
LINGXING_APP_ID=
LINGXING_APP_SECRET=

# ══ 服务 ══
HOST=127.0.0.1
PORT=8100
